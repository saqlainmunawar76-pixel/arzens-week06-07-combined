# =============================================================================
# Copy this file to terraform.tfvars and fill in real values.
# NEVER commit terraform.tfvars (with real values) to git — it's in .gitignore.
# =============================================================================

project_name = "arzens-ti-platform"
environment  = "dev"
aws_region   = "us-east-1"

vpc_cidr           = "10.0.0.0/16"
public_subnet_cidr = "10.0.1.0/24"
availability_zone  = "us-east-1a"

# IMPORTANT: replace with YOUR public IP in CIDR form, e.g. ["203.0.113.42/32"]
# Never leave this as 0.0.0.0/0 — that opens SSH to the entire internet.
admin_cidr_blocks = ["203.0.113.42/32"]

instance_type       = "t3.micro"
key_pair_name       = "my-existing-keypair"
root_volume_size_gb = 20

bucket_suffix = "logs-a1b2c3"

tags = {
  Owner = "saqlain"
  Track = "advanced-week06-07"
}
